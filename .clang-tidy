# Notes:
# - clang-analyzer-optin.core.EnumCastOutOfRange: Useful, complains about std::filesystem::file_size for no fucking reason
# - clang-analyzer-cplusplus.NewDeleteLeaks: borked (https://github.com/llvm/llvm-project/issues/55219)
# - bugprone-narrowing-conversions: There's so many conversions particularly between doubles and floats that it simply isn't feasible to keep up with 
#       clangd's extra pendantic check. The compiler does the bulk of the useful checks with -Wall
# - clang-diagnostic-unused-private-field: Maybe useful eventually, but not right now.
# - portability-template-virtual-member-function: not important
# - misc-static-assert: Useful, but currently fucked and whines about all asserts
# - performance-inefficient-string-concatenation: Useful, but this is done in tests for simplicity, and it
#   is both useful to be able to do this, and the overhead in tests is meaningless
# - bugprone-throwing-static-initialization: maybe useful, but doesn't come up much outside a FP in catch2
Checks: >
  bugprone-*,
  clang-*,
  misc-*,
  performance-*,
  portability-*,
  modernize-deprecated-headers,
  modernize-use-constexpr,
  modernize-use-string-view,
  optin.taint.*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-unchecked-optional-access,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-diagnostic-unused-parameter,
  -clang-diagnostic-unused-private-field,
  -misc-non-private-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-static-assert,
  -misc-use-anonymous-namespace,
  -performance-avoid-endl,
  -performance-enum-size,
  -readability-*,
  -portability-avoid-pragma-once,
  -portability-template-virtual-member-function,
  -misc-explicit-constructor,
  -performance-inefficient-string-concatenation,
  -bugprone-throwing-static-initialization

HeaderFilterRegex: ".*\\/src\\/raven\\/.*"
